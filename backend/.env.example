# ============================================================
# Automatic grading model
# Copy this file to backend/.env, then fill only the API keys.
# ============================================================

# Alibaba Cloud Model Studio (Bailian / Qwen)
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Shared model for grading, alignment, rubric audit, and conflict handling
GRADING_LLM_PROVIDER=bailian
GRADING_LLM_MODEL=qwen3.8-max
GRADING_LLM_THINKING=false
# Qwen3.8 Max supports JSON mode; keep it enabled for machine-parsed grades.
GRADING_LLM_JSON_MODE=true

# Optional teacher provenance label written to immutable grading events
GRADING_TEACHER_ID=default-teacher

# Minimum trusted teacher grades required per criterion before model pre-grading.
# 0 = start from the rubric immediately; 1 restores the original teacher-first gate.
AUTO_GRADE_MIN_TEACHER_SAMPLES=0

# Criterion-level model/teacher agreement automation.
# legacy = old authorization behavior; shadow = record only; adaptive = drive scheduling.
CONSISTENCY_AUTOMATION_MODE=adaptive
# Smoothed agreement is (A + alpha) / (A + E + alpha + beta).
CONSISTENCY_RELIABLE_THRESHOLD=0.80
CONSISTENCY_PRIOR_ALPHA=1
CONSISTENCY_PRIOR_BETA=1
CONSISTENCY_CALIBRATING_REVIEW_RATE=0.50
CONSISTENCY_RELIABLE_REVIEW_RATE=0.10
CONSISTENCY_UNRELIABLE_REVIEW_RATE=1.00
CONSISTENCY_SCORER_REVISION=v1
CONSISTENCY_REVIEW_POLICY_VERSION=v1

# ============================================================
# Legacy PDF to Markdown models (optional fallback parser)
# Existing installations may keep using DASHSCOPE_API_KEY;
# BAILIAN_API_KEY takes precedence when both are present.
# ============================================================
DASHSCOPE_API_KEY=

PDF_VISION_SCAN_PROVIDER=dashscope
PDF_VISION_SCAN_MODEL=5.4nano

PDF_TEXT_REFINE_PROVIDER=dashscope
PDF_TEXT_REFINE_MODEL=5.5

PDF_VISION_AUDIT_PROVIDER=dashscope
PDF_VISION_AUDIT_MODEL=5.4nano

PDF_FIGURE_VERIFY_PROVIDER=dashscope
PDF_FIGURE_VERIFY_MODEL=5.4nano

# Criteria editing utilities
CRITERIA_OPTIMIZE_PROVIDER=dashscope
CRITERIA_OPTIMIZE_MODEL=5.5
CRITERIA_TRANSFORM_PROVIDER=dashscope
CRITERIA_TRANSFORM_MODEL=5.5

# PDF concurrency
PDF_PAGE_MAX_WORKERS=1
PDF_VISION_MAX_WORKERS=3
PDF_API_RETRIES=3
PDF_API_RETRY_BASE_SECONDS=1.5

# Optional storage / server settings
# GRADING_DATA_DIR=
# GRADING_CRITERIA_DIR=
# GRADING_RESULTS_DIR=
# GRADING_CASE_ROOT=
# ALLOWED_ORIGINS=*

# Production web access: required, set a long random password.
GRADING_AUTH_USER=
GRADING_AUTH_PASSWORD=

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Hybrid parser uses backend/ocr/config.local.toml (separate DocMind credentials).
# Containers use the public OCR template plus these server-only credentials.
GRADING_OCR_API_KEY=
DOCMIND_ACCESS_KEY_ID=
DOCMIND_ACCESS_KEY_SECRET=
DOCMIND_SECURITY_TOKEN=
# GRADING_PARSER_CONFIG=/absolute/path/to/config.local.toml
# GRADING_FRONTEND_DIR=/absolute/path/to/frontend/dist
# GRADING_CRITERIA_BASELINE_DIR=
# GRADING_CASE_BASELINE_DIR=
